{
  "name": "autobahn-action",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Action that runs the Autobahn WebSocket testsuite against a server.",
  "license": "MIT",
  "author": "Farben",
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint && node scripts/check-conventions.mjs",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "verify": "pnpm check && pnpm typecheck && pnpm test",
    "check": "pnpm lint && pnpm format:check && pnpm check:skills && pnpm check:agents",
    "hooks:install": "lefthook install",
    "hooks:run": "lefthook run pre-commit --all-files",
    "check:skills": "node scripts/check-skills-lock.mjs",
    "check:agents": "sh scripts/check-agent-parity.sh"
  },
  "dependencies": {
    "@actions/artifact": "6.3.1",
    "@actions/core": "3.0.1",
    "arktype": "2.2.10"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.95.0",
    "@types/node": "24.19.2",
    "lefthook": "2.2.4",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.4.2"
}
