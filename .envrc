# The musl shell builds the Node toolchain from source, which makes the first
# load take many minutes. Use the host tools on musl when they are available
# and keep the pinned shell opt-in with `nix develop .#musl`.
if [ "$(uname -s)" = "Linux" ] && ldd /bin/sh 2>&1 | grep -iq "musl"; then
  if command -v node >/dev/null 2>&1 && command -v pnpm >/dev/null 2>&1; then
    PATH_add node_modules/.bin
    echo "direnv: musl host, using system Node and pnpm; run 'nix develop .#musl' for the pinned shell." >&2
  else
    use flake .#musl
  fi
else
  use flake .#default
fi
